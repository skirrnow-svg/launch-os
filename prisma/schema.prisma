  organizations       organizations        @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  segments            segments[]
  social_posts        social_posts[]
  workflows           workflows[]

  @@unique([org_id, slug])
  @@index([created_at(sort: Desc)], map: "idx_projects_created_at")
  @@index([org_id], map: "idx_projects_org_id")
