/// Autonomous Ad Agency subsystem — inbound lead triage. Tenant-isolated by
/// org_id (the internal organizations.id, resolved from the active Clerk org).
model Lead {
  id                String         @id @default(cuid())
  org_id            String         @db.Uuid
  email             String
  raw_body          String
  intent_status     String
  verification      Json?
  status            String         @default("PENDING")
  client_profile_id String?        @unique
  created_at        DateTime       @default(now()) @db.Timestamp(6)
  source            String         @default("inbound")
  auto_video        Boolean        @default(true)
  client_profile    ClientProfile? @relation(fields: [client_profile_id], references: [id], onUpdate: NoAction)

  @@index([org_id, status], map: "idx_leads_org_id_status")
  @@map("leads")
}

/// Onboarded client profile provisioned from a qualified Lead. Links 1-to-1
/// back to the Lead and directly to an existing Project.
model ClientProfile {
  id               String   @id @default(cuid())
  org_id           String   @db.Uuid
  company_name     String
  metro_area       String
  phone            String?
  niche            String
  brand_guidelines Json?
  project_id       String   @db.Uuid
  created_at       DateTime @default(now()) @db.Timestamp(6)
  project          projects @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lead             Lead?

  @@index([org_id], map: "idx_client_profiles_org_id")
  @@map("client_profiles")
}

model coupons {
  id              String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  code            String    @unique
  kind            String    @default("percent")
  value           Int       @default(0)
  applies_to      String    @default("all")
  max_redemptions Int?
  redeemed_count  Int       @default(0)
  expires_at      DateTime? @db.Timestamptz(6)
  active          Boolean   @default(true)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
}

model platform_settings {
  id                     String   @id @default("singleton")
  welcome_credits        Int      @default(0)
  intro_discount_percent Int      @default(0)
  offer_active           Boolean  @default(false)
  offer_label            String?
  updated_at             DateTime @default(now()) @db.Timestamptz(6)
}

model pricing_overrides {
  slug              String   @id
  price_inr         Int?
  credits_per_month Int?
  updated_at        DateTime @default(now()) @db.Timestamptz(6)
}
