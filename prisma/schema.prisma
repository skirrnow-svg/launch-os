generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ab_tests {
  id                  String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  campaign_id         String          @db.Uuid
  variant_a_subject   String
  variant_b_subject   String?
  variant_c_subject   String?
  variant_a_send_time DateTime?       @db.Timestamp(6)
  variant_b_send_time DateTime?       @db.Timestamp(6)
  variant_c_send_time DateTime?       @db.Timestamp(6)
  split_percent       Int             @default(10)
  test_duration_hours Int             @default(24)
  winner_metric       String
  winner_variant      String?
  winner_probability  Decimal?        @db.Decimal(5, 2)
  test_started_at     DateTime?       @db.Timestamp(6)
  test_completed_at   DateTime?       @db.Timestamp(6)
  created_at          DateTime?       @default(now()) @db.Timestamp(6)
  email_campaigns     email_campaigns @relation(fields: [campaign_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([campaign_id], map: "idx_ab_tests_campaign_id")
}

model api_usage {
  id               String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  org_id           String        @db.Uuid
  endpoint         String
  method           String
  status_code      Int
  response_time_ms Int?
  tokens_used      Int?          @default(0)
  timestamp        DateTime      @default(now()) @db.Timestamp(6)
  organizations    organizations @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([org_id], map: "idx_api_usage_org_id")
  @@index([timestamp(sort: Desc)], map: "idx_api_usage_timestamp")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model assets {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  project_id       String    @db.Uuid
  type             String
  name             String
  description      String?
  prompt           String?
  url              String?
  storage_key      String?   @unique
  file_size_bytes  Int?
  duration_seconds Int?
  dimensions       Json?
  metadata         Json?     @default("{}")
  status           String    @default("draft")
  error_message    String?
  created_by       String    @db.Uuid
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)
  users            users     @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projects         projects  @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([project_id], map: "idx_assets_project_id")
  @@index([status], map: "idx_assets_status")
  @@index([type], map: "idx_assets_type")
}

model audit_logs {
  id            String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  org_id        String        @db.Uuid
  user_id       String?       @db.Uuid
  action        String
  resource_type String
  resource_id   String?       @db.Uuid
  changes       Json?
  ip_address    String?
  user_agent    String?
  created_at    DateTime      @default(now()) @db.Timestamp(6)
  organizations organizations @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users?        @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_audit_logs_created_at")
  @@index([org_id], map: "idx_audit_logs_org_id")
  @@index([resource_type], map: "idx_audit_logs_resource_type")
  @@index([user_id], map: "idx_audit_logs_user_id")
}

model contacts {
  id                    String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  org_id                String               @db.Uuid
  email                 String               @db.Citext
  first_name            String?
  last_name             String?
  phone                 String?
  company               String?
  tags                  String[]             @default([])
  properties            Json?                @default("{}")
  segment_ids           String[]             @default([]) @db.Uuid
  email_bounced         Boolean?             @default(false)
  email_unsubscribed    Boolean?             @default(false)
  last_email_opened_at  DateTime?            @db.Timestamp(6)
  last_email_clicked_at DateTime?            @db.Timestamp(6)
  last_website_visit_at DateTime?            @db.Timestamp(6)
  total_emails_opened   Int?                 @default(0)
  total_emails_clicked  Int?                 @default(0)
  estimated_deal_value  Decimal?             @default(0) @db.Decimal(12, 2)
  source                String?              @default("manual")
  created_at            DateTime?            @default(now()) @db.Timestamp(6)
  updated_at            DateTime?            @default(now()) @db.Timestamp(6)
  organizations         organizations        @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  email_metrics         email_metrics[]
  email_recipients      email_recipients[]
  workflow_instances    workflow_instances[]

  @@unique([org_id, email])
  @@index([email], map: "idx_contacts_email")
  @@index([org_id], map: "idx_contacts_org_id")
  @@index([tags], map: "idx_contacts_tags", type: Gin)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model email_campaigns {
  id                 String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  project_id         String             @db.Uuid
  segment_id         String?            @db.Uuid
  name               String
  subject            String
  from_name          String
  from_email         String
  reply_to           String?
  template_html      String
  plain_text         String?
  status             String             @default("draft")
  schedule_time      DateTime?          @db.Timestamp(6)
  sent_at            DateTime?          @db.Timestamp(6)
  total_recipients   Int?               @default(0)
  emails_sent        Int?               @default(0)
  emails_opened      Int?               @default(0)
  emails_clicked     Int?               @default(0)
  emails_bounced     Int?               @default(0)
  conversion_count   Int?               @default(0)
  resend_campaign_id String?
  created_by         String             @db.Uuid
  created_at         DateTime?          @default(now()) @db.Timestamp(6)
  updated_at         DateTime?          @default(now()) @db.Timestamp(6)
  generation_brief   String?
  ab_tests           ab_tests[]
  users              users              @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projects           projects           @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  segments           segments?          @relation(fields: [segment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  email_metrics      email_metrics[]
  email_recipients   email_recipients[]

  @@index([project_id], map: "idx_email_campaigns_project_id")
  @@index([status], map: "idx_email_campaigns_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model email_metrics {
  id              String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  campaign_id     String          @db.Uuid
  contact_id      String          @db.Uuid
  event           String
  link_url        String?
  user_agent      String?
  ip_address      String?
  timestamp       DateTime        @db.Timestamp(6)
  created_at      DateTime?       @default(now()) @db.Timestamp(6)
  email_campaigns email_campaigns @relation(fields: [campaign_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contacts        contacts        @relation(fields: [contact_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([campaign_id], map: "idx_email_metrics_campaign_id")
  @@index([contact_id], map: "idx_email_metrics_contact_id")
  @@index([event], map: "idx_email_metrics_event")
  @@index([timestamp(sort: Desc)], map: "idx_email_metrics_timestamp")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model email_recipients {
  id              String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  campaign_id     String          @db.Uuid
  contact_id      String          @db.Uuid
  email_address   String          @db.Citext
  status          String          @default("pending")
  sent_at         DateTime?       @db.Timestamp(6)
  opened_at       DateTime?       @db.Timestamp(6)
  clicked_at      DateTime?       @db.Timestamp(6)
  bounced_at      DateTime?       @db.Timestamp(6)
  resend_email_id String?
  open_count      Int?            @default(0)
  click_count     Int?            @default(0)
  email_campaigns email_campaigns @relation(fields: [campaign_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contacts        contacts        @relation(fields: [contact_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([campaign_id, contact_id])
  @@index([campaign_id], map: "idx_email_recipients_campaign_id")
  @@index([contact_id], map: "idx_email_recipients_contact_id")
  @@index([status], map: "idx_email_recipients_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model integration_tokens {
  id            String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
