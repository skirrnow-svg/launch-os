# Launch OS — environment variables.
# Copy to .env.local (git-ignored) and fill in real values. NEVER commit secrets.
# On Hostinger, set these in the Node.js app's Environment Variables panel (not in the repo).

# ── Required for the web app to run ─────────────────────────────────────────

# Database (Neon Postgres) — use the POOLED connection string.
DATABASE_URL=postgresql://user:password@host-pooler.neon.tech/launch_os?sslmode=require

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Public base URL of the deployment.
# Start with the Hostinger temporary URL, then switch to the real domain at go-live.
NEXT_PUBLIC_APP_URL=https://your-app.hostingersite.com

# Encryption key for org integration tokens (32-byte hex; AES-256-GCM).
SETTINGS_ENCRYPTION_KEY=

# ── Generation queue (edge/web tier -> GitHub Actions runner) ────────────────
# The web app enqueues jobs and fires a repository_dispatch; the runner generates.
GENERATION_MODE=queue
GITHUB_DISPATCH_REPO=skirrnow-svg/launch-os
GITHUB_DISPATCH_TOKEN=github_pat_...        # PAT with repo dispatch scope

# Org UUID the public /get-started lead form writes to.
DEFAULT_LEAD_ORG_ID=

# ── Storage (Cloudflare R2) — for generated media ───────────────────────────
R2_BUCKET_NAME=launch-os-assets
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...

# ── Outbound integrations (optional) ────────────────────────────────────────
RESEND_API_KEY=re_...
BUFFER_API_TOKEN=...

# ── App config ──────────────────────────────────────────────────────────────
NODE_ENV=production

# Clerk routing (non-secret; safe to commit real values)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ── Runner-only knobs (set on the GitHub Actions runner, not the web host) ───
# HIGGSFIELD_MONTHLY_CAP=200   # hard credit ceiling; do not raise without owner sign-off
# CLAUDE_CODE_MODEL=sonnet     # model for claude -p copy generation
# MAX_JOBS=5

# NOTE: No CLAUDE_API_KEY or HIGGSFIELD_API_KEY is required — copy is generated
# via the Claude Code subscription CLI (claude -p) and media via the Higgsfield
# subscription CLI, both on the GitHub Actions runner. See docs/HIGGSFIELD_GUARDRAILS.md.

# Monitoring (optional)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
SENTRY_DSN=...
