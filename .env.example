# Launch OS — environment variables.
# Copy to .env.local (git-ignored) and fill in real values. NEVER commit secrets.

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host.neon.tech/launch_os?sslmode=require

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# AI & asset generation
CLAUDE_API_KEY=sk-ant-...
HIGGSFIELD_API_KEY=...        # Basic plan — confirm API access; guardrails in docs/HIGGSFIELD_GUARDRAILS.md

# Email
RESEND_API_KEY=re_...

# Social
BUFFER_API_TOKEN=...

# Storage (Cloudflare R2)
R2_BUCKET_NAME=launch-os-assets
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...

# App config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Monitoring (optional)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
SENTRY_DSN=...
